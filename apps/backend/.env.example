# PostgreSQL — get this from Railway after adding a Postgres plugin
DATABASE_URL=postgresql://user:password@host:port/dbname

# Kalshi — from kalshi.com > Settings > API
# Key ID (the UUID shown on the API key page)
KALSHI_KEY_ID=your_kalshi_key_id
# RSA private key — paste the full PEM including BEGIN/END headers, with \n between lines
KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMII...\n-----END RSA PRIVATE KEY-----

# Anthropic — from console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key

# Tavily — from app.tavily.com (free tier: 1000 req/mo)
TAVILY_API_KEY=your_tavily_api_key

# NewsAPI — from newsapi.org (free tier: 100 req/day)
NEWS_API_KEY=your_newsapi_key

# Risk parameters
BANKROLL=100
MAX_BET=5
MIN_EDGE=0.05
KELLY_FRACTION=0.25

# Pipeline schedule (cron syntax, default = every 2 hours)
PIPELINE_SCHEDULE=0 */2 * * *

PORT=3001
FRONTEND_URL=http://localhost:3000
